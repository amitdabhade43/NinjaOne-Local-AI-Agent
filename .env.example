# Foundry Local endpoint is discovered automatically using the Foundry CLI.
# The agent reads the dynamic port and rediscovers it after a connection failure.
# Set this only as a fallback for older/custom Foundry installations.
FOUNDRY_BASE_URL=
FOUNDRY_API_KEY=not-needed
# Optional exact model ID. Blank selects the first model reported by Foundry.
FOUNDRY_MODEL=

# Agent API. Keep 127.0.0.1 for local-only access.
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO

# Local NinjaOne MCP gateway is launched over STDIO.
# Defaults assume both repositories are sibling folders under C:\\project.
# Optional overrides:
# NINJAONE_GATEWAY_DIR=C:\\project\\NinjaRMM-API-Gateway-MCP
# NINJAONE_GATEWAY_PYTHON=C:\\project\\NinjaRMM-API-Gateway-MCP\\.venv\\Scripts\\python.exe
# NINJAONE_GATEWAY_ENV_FILE=C:\\project\\NinjaRMM-API-Gateway-MCP\\.env

# Agent safety and execution limits
MAX_AGENT_STEPS=6
REQUEST_TIMEOUT_SECONDS=90
APPROVAL_REQUIRED_FOR_WRITES=true
ALLOW_DELETE_OPERATIONS=false
